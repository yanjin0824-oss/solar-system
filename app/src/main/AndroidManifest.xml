<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SolarSystemTheme"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.SolarSystemTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Volumetric DefaultWindowContainer Configuration -->

            <!-- The unique name/id of the WindowContainer -->
            <meta-data
                android:name="pico.spatial.windowcontainer.id"
                android:value="SolarSystemVolume" />

            <!-- Form/style of the WindowContainer: 2 = Form.Volumetric -->
            <meta-data
                android:name="pico.spatial.windowcontainer.style"
                android:value="2" />

            <!-- Default size of the Volumetric WindowContainer, in dp -->
            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize"
                android:value="960x960x960" />

            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize.unit"
                android:value="dp" />

            <!-- ContentMinSize resize behavior -->
            <meta-data
                android:name="pico.spatial.windowcontainer.resizetype"
                android:value="0" />

            <!-- Uniform resizing -->
            <meta-data
                android:name="pico.spatial.windowcontainer.resizerestriction"
                android:value="1" />

            <!-- Fixed world scale -->
            <meta-data
                android:name="pico.spatial.windowcontainer.worldscaletype"
                android:value="2" />

            <!-- Auto-hide the caption bar -->
            <meta-data
                android:name="pico.spatial.windowcontainer.captionbar"
                android:value="1" />

            <!-- Transparent volume; the orrery floats in Shared Space -->
            <meta-data
                android:name="pico.spatial.windowcontainer.materialbackground"
                android:value="0" />

            <meta-data
                android:name="pico.spatial.windowcontainer.volumealignment"
                android:value="0" />

            <!-- Hide the volume base panel -->
            <meta-data
                android:name="pico.spatial.windowcontainer.volumebasepanel"
                android:value="1" />

        </activity>

        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
