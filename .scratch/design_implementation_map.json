{
  "schema_version": 1,
  "design_spec": {
    "path": "design-spec.json",
    "sha256": "5863c5e130acd909d6dd93eafc3aaf23b78caa3abac44c2eb091431e358d1fef"
  },
  "implementation": {
    "initialStateId": "overview",
    "surfaces": {
      "main": {
        "type": "volumetric",
        "defaultSize": {
          "width": 960,
          "height": 960,
          "depth": 960,
          "unit": "dp"
        },
        "minSize": {
          "width": 640,
          "height": 640,
          "depth": 640,
          "unit": "dp"
        },
        "maxSize": {
          "width": 1600,
          "height": 1600,
          "depth": 1600,
          "unit": "dp"
        },
        "rootNodeId": "stage-root"
      }
    },
    "nodes": {
      "stage-root": {
        "kind": "layout",
        "role": "content",
        "trigger": "always-visible",
        "relationship": "peer",
        "presentation": "inline",
        "layout": {
          "mode": "stack",
          "overflow": "hidden"
        },
        "children": [
          "scene",
          "hint-layer",
          "fact-popup"
        ]
      },
      "scene": {
        "kind": "domain_visual",
        "rendererKey": "orrery-scene",
        "role": "content",
        "trigger": "always-visible",
        "relationship": "peer",
        "presentation": "inline",
        "props": {
          "background": {
            "base": "spaceBase",
            "nebula": "spaceNebula",
            "star": "star",
            "starCount": 90,
            "starSeed": 42
          },
          "sun": {
            "core": "sunCore",
            "glow": "sunGlow",
            "radius": 54
          },
          "planets": [
            {
              "id": "mercury",
              "color": "mercury",
              "orbitRadius": 120,
              "orbitDuration": 8,
              "size": 10,
              "startAngle": 20
            },
            {
              "id": "venus",
              "color": "venus",
              "orbitRadius": 165,
              "orbitDuration": 13,
              "size": 15,
              "startAngle": 130
            },
            {
              "id": "earth",
              "color": "earth",
              "orbitRadius": 215,
              "orbitDuration": 19,
              "size": 16,
              "startAngle": 240
            },
            {
              "id": "mars",
              "color": "mars",
              "orbitRadius": 265,
              "orbitDuration": 27,
              "size": 12,
              "startAngle": 310
            },
            {
              "id": "jupiter",
              "color": "jupiter",
              "orbitRadius": 330,
              "orbitDuration": 38,
              "size": 26,
              "startAngle": 80
            }
          ],
          "selectedPlanetBinding": "selectedPlanetId",
          "focusScale": 1.55
        },
        "events": {
          "planet-select": "select-planet"
        },
        "visibleInStates": [
          "overview",
          "planet-focus"
        ],
        "accessibilityLabel": "Interactive solar system. Click a planet to focus it."
      },
      "hint-layer": {
        "kind": "layout",
        "role": "auxiliary",
        "trigger": "always-visible",
        "relationship": "supports",
        "presentation": "inline",
        "layout": {
          "mode": "row",
          "gapDp": 8,
          "align": "center",
          "paddingDp": {
            "top": 32,
            "right": 0,
            "bottom": 0,
            "left": 32
          }
        },
        "children": [
          "hint-icon",
          "hint-text"
        ],
        "visibleInStates": [
          "overview"
        ]
      },
      "hint-icon": {
        "kind": "spatialui",
        "component": "sui-icon",
        "assetId": "sun-icon",
        "props": {
          "size": 20,
          "tint": "sunGlow"
        }
      },
      "hint-text": {
        "kind": "text",
        "content": "Point at a planet and click to focus",
        "textStyle": {
          "typography": "bodyMedium",
          "color": "labelPrimaryLight"
        }
      },
      "fact-popup": {
        "kind": "spatialui",
        "component": "sui-spatial-popup",
        "role": "detail",
        "trigger": "selection-driven",
        "relationship": "derives-from-selection",
        "presentation": "popup",
        "props": {
          "horizontal-placement": "to-end-of",
          "vertical-placement": "center",
          "offset-y": 0,
          "corner-radius": 20,
          "default-min-width": 280,
          "clipping-enabled": true,
          "viewport-padding": 24,
          "anchor-binding": "selectedPlanetId",
          "dismiss-on-click-outside": false,
          "dismiss-on-escape": true,
          "offset-x": 32
        },
        "events": {
          "dismiss-request": "dismiss-facts"
        },
        "children": [
          "fact-card"
        ],
        "visibleInStates": [
          "planet-focus"
        ]
      },
      "fact-card": {
        "kind": "layout",
        "role": "detail",
        "trigger": "selection-driven",
        "relationship": "derives-from-selection",
        "presentation": "popup",
        "layout": {
          "mode": "column",
          "gapDp": 16,
          "paddingDp": 24,
          "widthDp": 340
        },
        "children": [
          "fact-header",
          "fact-body"
        ]
      },
      "fact-header": {
        "kind": "layout",
        "layout": {
          "mode": "row",
          "gapDp": 12,
          "align": "start",
          "justify": "space-between"
        },
        "children": [
          "fact-identity",
          "fact-close"
        ]
      },
      "fact-identity": {
        "kind": "layout",
        "layout": {
          "mode": "row",
          "gapDp": 12,
          "align": "center"
        },
        "children": [
          "fact-icon",
          "fact-title-group"
        ]
      },
      "fact-icon": {
        "kind": "spatialui",
        "component": "sui-icon",
        "assetId": "planet-icon",
        "props": {
          "size": 32,
          "tint": "earth"
        },
        "bindings": {
          "tint": "selectedPlanet.color"
        }
      },
      "fact-title-group": {
        "kind": "layout",
        "layout": {
          "mode": "column",
          "gapDp": 2
        },
        "children": [
          "fact-title",
          "fact-subtitle"
        ]
      },
      "fact-title": {
        "kind": "text",
        "content": "Earth",
        "bindings": {
          "text": "selectedPlanet.name"
        },
        "textStyle": {
          "typography": "headlineLarge",
          "color": "labelPrimary"
        }
      },
      "fact-subtitle": {
        "kind": "text",
        "content": "Terrestrial planet",
        "bindings": {
          "text": "selectedPlanet.type"
        },
        "textStyle": {
          "typography": "bodyMedium",
          "color": "labelSecondary"
        }
      },
      "fact-close": {
        "kind": "spatialui",
        "component": "sui-icon-button",
        "props": {
          "size": "regular",
          "navigation-action": "close"
        },
        "events": {
          "click-action": "close-facts"
        },
        "children": [
          "close-icon"
        ],
        "accessibilityLabel": "Close planet facts"
      },
      "close-icon": {
        "kind": "spatialui",
        "component": "sui-icon",
        "assetId": "close-icon",
        "props": {
          "size": 24
        }
      },
      "fact-body": {
        "kind": "layout",
        "layout": {
          "mode": "column",
          "gapDp": 12
        },
        "children": [
          "fact-description",
          "fact-divider",
          "stat-grid",
          "fact-note"
        ]
      },
      "fact-description": {
        "kind": "text",
        "content": "The only known world with liquid-water oceans and life.",
        "bindings": {
          "text": "selectedPlanet.fact"
        },
        "textStyle": {
          "typography": "bodyMediumMultiline",
          "color": "labelSecondary"
        }
      },
      "fact-divider": {
        "kind": "spatialui",
        "component": "sui-divider",
        "props": {}
      },
      "stat-grid": {
        "kind": "layout",
        "layout": {
          "mode": "grid",
          "columns": 2,
          "gapDp": 12
        },
        "children": [
          "stat-distance",
          "stat-day",
          "stat-year",
          "stat-moons"
        ]
      },
      "stat-distance": {
        "kind": "layout",
        "layout": {
          "mode": "column",
          "gapDp": 2
        },
        "children": [
          "stat-distance-label",
          "stat-distance-value"
        ]
      },
      "stat-distance-label": {
        "kind": "text",
        "content": "Distance from sun",
        "textStyle": {
          "typography": "bodySmall",
          "color": "labelTertiary"
        }
      },
      "stat-distance-value": {
        "kind": "text",
        "content": "1.00 AU",
        "bindings": {
          "text": "selectedPlanet.stats.distance"
        },
        "textStyle": {
          "typography": "titleSmall",
          "color": "labelPrimary"
        }
      },
      "stat-day": {
        "kind": "layout",
        "layout": {
          "mode": "column",
          "gapDp": 2
        },
        "children": [
          "stat-day-label",
          "stat-day-value"
        ]
      },
      "stat-day-label": {
        "kind": "text",
        "content": "Day length",
        "textStyle": {
          "typography": "bodySmall",
          "color": "labelTertiary"
        }
      },
      "stat-day-value": {
        "kind": "text",
        "content": "24 hours",
        "bindings": {
          "text": "selectedPlanet.stats.day"
        },
        "textStyle": {
          "typography": "titleSmall",
          "color": "labelPrimary"
        }
      },
      "stat-year": {
        "kind": "layout",
        "layout": {
          "mode": "column",
          "gapDp": 2
        },
        "children": [
          "stat-year-label",
          "stat-year-value"
        ]
      },
      "stat-year-label": {
        "kind": "text",
        "content": "Year length",
        "textStyle": {
          "typography": "bodySmall",
          "color": "labelTertiary"
        }
      },
      "stat-year-value": {
        "kind": "text",
        "content": "365.25 days",
        "bindings": {
          "text": "selectedPlanet.stats.year"
        },
        "textStyle": {
          "typography": "titleSmall",
          "color": "labelPrimary"
        }
      },
      "stat-moons": {
        "kind": "layout",
        "layout": {
          "mode": "column",
          "gapDp": 2
        },
        "children": [
          "stat-moons-label",
          "stat-moons-value"
        ]
      },
      "stat-moons-label": {
        "kind": "text",
        "content": "Known moons",
        "textStyle": {
          "typography": "bodySmall",
          "color": "labelTertiary"
        }
      },
      "stat-moons-value": {
        "kind": "text",
        "content": "1",
        "bindings": {
          "text": "selectedPlanet.stats.moons"
        },
        "textStyle": {
          "typography": "titleSmall",
          "color": "labelPrimary"
        }
      },
      "fact-note": {
        "kind": "text",
        "content": "Stylized scale · quick facts",
        "textStyle": {
          "typography": "labelSmall",
          "color": "labelQuaternary"
        }
      }
    },
    "states": {
      "overview": {
        "surfaceRoots": {
          "main": "stage-root"
        }
      },
      "planet-focus": {
        "surfaceRoots": {
          "main": "stage-root"
        }
      }
    },
    "transitions": {
      "open-planet": {
        "from": "overview",
        "to": "planet-focus",
        "trigger": {
          "nodeId": "scene",
          "event": "planet-select"
        }
      },
      "close-planet": {
        "from": "planet-focus",
        "to": "overview",
        "trigger": {
          "nodeId": "fact-close",
          "event": "click-action"
        }
      },
      "dismiss-planet": {
        "from": "planet-focus",
        "to": "overview",
        "trigger": {
          "nodeId": "fact-popup",
          "event": "dismiss-request"
        }
      }
    },
    "actions": {
      "select-planet": {
        "type": "set",
        "binding": "selectedPlanetId",
        "value": "{{event.detail.planetId}}"
      },
      "focus-planet": {
        "type": "transition",
        "transitionId": "open-planet"
      },
      "close-facts": {
        "type": "transition",
        "transitionId": "close-planet"
      },
      "dismiss-facts": {
        "type": "transition",
        "transitionId": "dismiss-planet"
      }
    },
    "responsiveRules": {
      "compact-popup": {
        "surfaceId": "main",
        "when": {
          "maxWidthDp": 820
        },
        "overrides": [
          {
            "nodeId": "fact-card",
            "layout": {
              "mode": "column",
              "gapDp": 12,
              "paddingDp": 16,
              "widthDp": 280
            }
          },
          {
            "nodeId": "hint-layer",
            "layout": {
              "mode": "row",
              "gapDp": 8,
              "align": "center",
              "paddingDp": {
                "top": 16,
                "right": 0,
                "bottom": 0,
                "left": 16
              }
            }
          }
        ]
      }
    },
    "dataCases": [
      "error",
      "fallback",
      "normal"
    ],
    "assets": {
      "close-icon": {
        "kind": "icon",
        "src": "icon70://7.0/ic_cross",
        "alt": "Close"
      },
      "planet-icon": {
        "kind": "icon",
        "src": "icon70://7.0/ic_planet",
        "alt": "Planet"
      },
      "sun-icon": {
        "kind": "icon",
        "src": "icon70://7.0/ic_sun",
        "alt": "Sun"
      }
    }
  },
