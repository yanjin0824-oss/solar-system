    "typography": {
      "headlineLarge": {
        "family": "system-ui",
        "sizeDp": 24,
        "lineHeightDp": 30,
        "weight": 700
      },
      "titleSmall": {
        "family": "system-ui",
        "sizeDp": 14,
        "lineHeightDp": 18,
        "weight": 600
      },
      "bodyLarge": {
        "family": "system-ui",
        "sizeDp": 16,
        "lineHeightDp": 20,
        "weight": 500
      },
      "bodyMedium": {
        "family": "system-ui",
        "sizeDp": 14,
        "lineHeightDp": 18,
        "weight": 500
      },
      "bodyMediumMultiline": {
        "family": "system-ui",
        "sizeDp": 14,
        "lineHeightDp": 22,
        "weight": 500
      },
      "bodySmall": {
        "family": "system-ui",
        "sizeDp": 12,
        "lineHeightDp": 16,
        "weight": 500
      },
      "labelSmall": {
        "family": "system-ui",
        "sizeDp": 11,
        "lineHeightDp": 14,
        "weight": 600
      }
    },
    "spacing": {
      "small": 8,
      "regular": 16,
      "medium": 24,
      "large": 32
    }
  },
  "surfaces": [
    {
      "id": "main",
      "type": "stage_full",
      "defaultSize": {
        "width": 4,
        "height": 3,
        "depth": 4,
        "unit": "m"
      },
      "minSize": {
        "width": 3,
        "height": 2.4,
        "depth": 3,
        "unit": "m"
      },
      "maxSize": {
        "width": 6,
        "height": 4.5,
        "depth": 6,
        "unit": "m"
      },
      "rootNodeId": "stage-root"
    }
  ],
  "initialStateId": "overview",
  "states": [
    {
      "id": "overview",
      "surfaceRoots": {
        "main": "stage-root"
      }
    },
    {
      "id": "planet-focus",
      "surfaceRoots": {
        "main": "stage-root"
      }
    }
  ],
  "transitions": [
    {
      "id": "open-planet",
      "from": "overview",
      "to": "planet-focus",
      "trigger": {
        "nodeId": "scene",
        "event": "planet-select"
      }
    },
    {
      "id": "close-planet",
      "from": "planet-focus",
      "to": "overview",
      "trigger": {
        "nodeId": "fact-close",
        "event": "click-action"
      }
    },
    {
      "id": "dismiss-planet",
      "from": "planet-focus",
      "to": "overview",
      "trigger": {
        "nodeId": "fact-popup",
        "event": "dismiss-request"
      }
    }
  ],
  "actions": [
    {
      "id": "select-planet",
      "type": "set",
      "purpose": "Record the planet the user selected and open its quick-facts card.",
      "binding": "selectedPlanetId",
      "value": "{{event.detail.planetId}}"
    },
    {
      "id": "focus-planet",
      "type": "transition",
      "purpose": "Move from the overview to the focused planet state.",
      "transitionId": "open-planet"
    },
    {
      "id": "close-facts",
      "type": "transition",
      "purpose": "Return to the orbiting overview from the facts card.",
      "transitionId": "close-planet"
    },
    {
      "id": "dismiss-facts",
      "type": "transition",
      "purpose": "Return to the orbiting overview when the card is dismissed.",
      "transitionId": "dismiss-planet"
    }
  ],
