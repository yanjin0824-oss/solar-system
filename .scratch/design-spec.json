{
  "schemaVersion": "1.0",
  "metadata": {
    "projectName": "Interactive 3D Solar System",
    "sourceMode": "intent_only",
    "revision": 2
  },
  "experience": {
    "subject": "solar system",
    "user": "curious spatial explorer",
    "context": "standing in full space, at arm's length from an orrery",
    "singleJob": "inspect a planet and learn one quick fact about it",
    "space": "full",
    "form": "stage_full",
    "signature": "sun-centered orrery with a planet dossier card"
  },
