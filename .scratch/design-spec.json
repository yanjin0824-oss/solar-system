      "content": "24 hours",
      "textStyle": {
        "typography": "titleSmall",
        "color": "labelPrimary"
      },
      "bindings": {
        "text": "selectedPlanet.stats.day"
      }
    },
    {
      "id": "stat-year",
      "kind": "layout",
      "layout": {
        "mode": "column",
        "gapDp": 2
      },
      "children": [
        "stat-year-label",
        "stat-year-value"
      ]
    },
    {
      "id": "stat-year-label",
      "kind": "text",
      "content": "Year length",
      "textStyle": {
        "typography": "bodySmall",
        "color": "labelTertiary"
      }
    },
    {
      "id": "stat-year-value",
      "kind": "text",
      "content": "365.25 days",
      "textStyle": {
        "typography": "titleSmall",
        "color": "labelPrimary"
      },
      "bindings": {
        "text": "selectedPlanet.stats.year"
      }
    },
    {
      "id": "stat-moons",
      "kind": "layout",
      "layout": {
        "mode": "column",
        "gapDp": 2
      },
      "children": [
        "stat-moons-label",
        "stat-moons-value"
      ]
    },
    {
      "id": "stat-moons-label",
      "kind": "text",
      "content": "Known moons",
      "textStyle": {
        "typography": "bodySmall",
        "color": "labelTertiary"
      }
    },
    {
      "id": "stat-moons-value",
      "kind": "text",
      "content": "1",
      "textStyle": {
        "typography": "titleSmall",
        "color": "labelPrimary"
      },
      "bindings": {
        "text": "selectedPlanet.stats.moons"
      }
    },
    {
      "id": "fact-note",
      "kind": "text",
      "content": "Stylized scale · quick facts",
      "textStyle": {
        "typography": "labelSmall",
        "color": "labelQuaternary"
      }
    }
  ],
  "responsiveRules": [
    {
      "id": "compact-popup",
      "surfaceId": "main",
      "when": {
