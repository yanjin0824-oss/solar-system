  "nodes": [
    {
      "id": "stage-root",
      "kind": "layout",
      "role": "content",
      "trigger": "always-visible",
      "relationship": "peer",
      "presentation": "inline",
      "layout": {
        "mode": "stack",
        "overflow": "hidden"
      },
      "children": [
        "scene",
        "hint-layer",
        "fact-popup"
      ]
    },
    {
      "id": "scene",
      "kind": "domain_visual",
      "rendererKey": "orrery-scene",
      "purpose": "Show the glowing sun and five stylized planets orbiting at different speeds, and let the user select one.",
      "role": "content",
      "trigger": "always-visible",
      "relationship": "peer",
      "presentation": "inline",
      "accessibilityLabel": "Interactive solar system. Click a planet to focus it.",
      "props": {
        "background": {
          "base": "spaceBase",
          "nebula": "spaceNebula",
          "star": "star",
          "starCount": 90,
          "starSeed": 42
        },
        "sun": {
          "core": "sunCore",
          "glow": "sunGlow",
          "radius": 54
        },
        "planets": [
          {
            "id": "mercury",
            "color": "mercury",
            "orbitRadius": 120,
            "orbitDuration": 8,
            "size": 10,
            "startAngle": 20
          },
          {
            "id": "venus",
            "color": "venus",
            "orbitRadius": 165,
            "orbitDuration": 13,
            "size": 15,
            "startAngle": 130
          },
          {
            "id": "earth",
            "color": "earth",
            "orbitRadius": 215,
            "orbitDuration": 19,
            "size": 16,
            "startAngle": 240
          },
          {
            "id": "mars",
            "color": "mars",
            "orbitRadius": 265,
            "orbitDuration": 27,
            "size": 12,
            "startAngle": 310
          },
          {
            "id": "jupiter",
            "color": "jupiter",
            "orbitRadius": 330,
            "orbitDuration": 38,
            "size": 26,
            "startAngle": 80
          }
        ],
        "selectedPlanetBinding": "selectedPlanetId",
        "focusScale": 1.55
      },
      "parts": {
        "sun": {
          "appearance": {
            "fill": "sunCore",
            "radiusDp": 32
          },
          "states": {
            "glow": {
              "fill": "sunGlow"
            }
          }
        },
        "orbit": {
          "appearance": {
            "fill": "orbitLine",
            "opacity": 0.55
          }
        },
        "planetBody": {
          "appearance": {
            "fill": "fillSecondary",
            "radiusDp": 32
          },
          "states": {
            "selected": {
              "fill": "focusRing",
              "depthDp": 12
            }
          }
        },
        "star": {
          "appearance": {
            "fill": "star",
            "radiusDp": 32,
            "opacity": 0.8
          }
        },
        "space": {
          "appearance": {
            "fill": "spaceBase"
          }
        },
        "nebula": {
          "appearance": {
            "fill": "spaceNebula",
            "opacity": 0.9
          }
        }
      },
      "events": {
        "planet-select": "select-planet"
      },
      "visibleInStates": [
        "overview",
        "planet-focus"
      ]
    },
    {
      "id": "hint-layer",
      "kind": "layout",
      "role": "auxiliary",
      "trigger": "always-visible",
      "relationship": "supports",
      "presentation": "inline",
      "layout": {
        "mode": "row",
        "gapDp": 8,
        "align": "center",
        "paddingDp": {
          "top": 32,
          "right": 0,
          "bottom": 0,
          "left": 32
        }
      },
      "children": [
        "hint-icon",
        "hint-text"
      ],
      "visibleInStates": [
        "overview"
      ]
    },
    {
      "id": "hint-icon",
      "kind": "spatialui",
      "component": "sui-icon",
      "assetId": "sun-icon",
      "props": {
        "size": 20,
        "tint": "sunGlow"
      }
    },
    {
      "id": "hint-text",
      "kind": "text",
      "content": "Point at a planet and click to focus",
      "textStyle": {
        "typography": "bodyMedium",
        "color": "labelPrimaryLight"
      }
    },
    {
      "id": "fact-popup",
      "kind": "spatialui",
      "component": "sui-spatial-popup",
      "role": "detail",
      "trigger": "selection-driven",
      "relationship": "derives-from-selection",
      "presentation": "popup",
      "props": {
        "horizontal-placement": "to-end-of",
        "vertical-placement": "center",
        "offset-y": 0,
        "corner-radius": 20,
        "default-min-width": 280,
        "clipping-enabled": true,
        "viewport-padding": 24,
        "anchor-binding": "selectedPlanetId",
        "dismiss-on-click-outside": false,
        "dismiss-on-escape": true,
        "offset-x": 32
      },
      "children": [
        "fact-card"
      ],
      "events": {
        "dismiss-request": "dismiss-facts"
      },
      "visibleInStates": [
        "planet-focus"
      ]
    },
    {
      "id": "fact-card",
      "kind": "layout",
      "role": "detail",
      "trigger": "selection-driven",
      "relationship": "derives-from-selection",
      "presentation": "popup",
      "layout": {
        "mode": "column",
        "gapDp": 16,
        "paddingDp": 24,
        "widthDp": 340
      },
      "children": [
        "fact-header",
        "fact-body"
      ]
    },
    {
      "id": "fact-header",
      "kind": "layout",
      "layout": {
        "mode": "row",
        "gapDp": 12,
        "align": "start",
        "justify": "space-between"
      },
      "children": [
        "fact-identity",
        "fact-close"
      ]
    },
    {
      "id": "fact-identity",
      "kind": "layout",
      "layout": {
        "mode": "row",
        "gapDp": 12,
        "align": "center"
      },
      "children": [
        "fact-icon",
        "fact-title-group"
      ]
    },
    {
      "id": "fact-icon",
      "kind": "spatialui",
      "component": "sui-icon",
      "assetId": "planet-icon",
      "props": {
        "size": 32,
        "tint": "earth"
      },
      "bindings": {
        "tint": "selectedPlanet.color"
      }
    },
    {
      "id": "fact-title-group",
      "kind": "layout",
      "layout": {
        "mode": "column",
        "gapDp": 2
      },
      "children": [
        "fact-title",
        "fact-subtitle"
      ]
    },
    {
      "id": "fact-title",
      "kind": "text",
      "content": "Earth",
      "textRole": "surface_title",
      "textStyle": {
        "typography": "headlineLarge",
        "color": "labelPrimary"
      },
      "bindings": {
        "text": "selectedPlanet.name"
      }
    },
    {
      "id": "fact-subtitle",
      "kind": "text",
      "content": "Terrestrial planet",
      "textStyle": {
        "typography": "bodyMedium",
        "color": "labelSecondary"
      },
      "bindings": {
        "text": "selectedPlanet.type"
      }
    },
    {
      "id": "fact-close",
      "kind": "spatialui",
      "component": "sui-icon-button",
      "props": {
        "size": "regular",
        "navigation-action": "close"
      },
      "accessibilityLabel": "Close planet facts",
      "children": [
        "close-icon"
      ],
      "events": {
        "click-action": "close-facts"
      }
    },
    {
      "id": "close-icon",
      "kind": "spatialui",
      "component": "sui-icon",
      "assetId": "close-icon",
      "props": {
        "size": 24
      }
    },
    {
      "id": "fact-body",
      "kind": "layout",
      "layout": {
        "mode": "column",
        "gapDp": 12
      },
      "children": [
        "fact-description",
        "fact-divider",
        "stat-grid",
        "fact-note"
      ]
    },
    {
      "id": "fact-description",
      "kind": "text",
      "content": "The only known world with liquid-water oceans and life.",
      "textStyle": {
        "typography": "bodyMediumMultiline",
        "color": "labelSecondary"
      },
      "bindings": {
        "text": "selectedPlanet.fact"
      }
    },
    {
      "id": "fact-divider",
      "kind": "spatialui",
      "component": "sui-divider",
      "props": {}
    },
    {
      "id": "stat-grid",
      "kind": "layout",
      "layout": {
        "mode": "grid",
        "columns": 2,
        "gapDp": 12
      },
      "children": [
        "stat-distance",
        "stat-day",
        "stat-year",
        "stat-moons"
      ]
    },
    {
      "id": "stat-distance",
      "kind": "layout",
      "layout": {
        "mode": "column",
        "gapDp": 2
      },
      "children": [
        "stat-distance-label",
        "stat-distance-value"
      ]
    },
    {
      "id": "stat-distance-label",
      "kind": "text",
      "content": "Distance from sun",
      "textStyle": {
        "typography": "bodySmall",
        "color": "labelTertiary"
      }
    },
    {
      "id": "stat-distance-value",
      "kind": "text",
      "content": "1.00 AU",
      "textStyle": {
        "typography": "titleSmall",
        "color": "labelPrimary"
      },
      "bindings": {
        "text": "selectedPlanet.stats.distance"
      }
    },
    {
      "id": "stat-day",
      "kind": "layout",
      "layout": {
        "mode": "column",
        "gapDp": 2
      },
      "children": [
        "stat-day-label",
        "stat-day-value"
      ]
    },
    {
      "id": "stat-day-label",
      "kind": "text",
